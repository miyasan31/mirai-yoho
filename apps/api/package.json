{
  "name": "@mirai-yoho/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/index.ts",
    "build": "esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.js --external:firebase-admin --external:google-auth-library --external:stripe --external:resend",
    "start": "node dist/server.js",
    "tsc": "tsc --noEmit",
    "tsc:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@mirai-yoho/shared": "workspace:*",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.2",
    "hono": "^4.12.29",
    "resend": "^6.9.4",
    "stripe": "^20.4.1",
    "tsx": "^4.21.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.1",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
