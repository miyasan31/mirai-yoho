# 各値の取得・生成方法は doc/environment-variables.md を参照
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Zoom (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
# Zoom (User OAuth)
ZOOM_USER_OAUTH_CLIENT_ID=
ZOOM_USER_OAUTH_CLIENT_SECRET=
ZOOM_USER_OAUTH_REDIRECT_URI= # 任意（デフォルト API_URL + /api/auth/zoom/callback）。ローカルは Zoom が localhost を許可しないため http://127.0.0.1:3000/api/auth/zoom/callback を設定する
ZOOM_OAUTH_STATE_SECRET= # openssl rand -hex 32
ZOOM_CREDENTIAL_ENCRYPTION_KEY= # base64 of 32 bytes: openssl rand -base64 32
# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@example.com
EMAIL_DELIVERY_MODE=resend # or log
# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# LINE WORKS
LINE_WORKS_LATE_ARRIVAL_WEBHOOK_URL=https://webhook.worksmobile.com/message/...
# App URLs
API_URL=http://localhost:3000
USER_APP_URL=http://localhost:3010
CONSOLE_APP_URL=http://localhost:3020
CONSULTANT_APP_URL=http://localhost:3030
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3020,http://localhost:3030
INVOICE_REGISTRATION_NUMBER=T0000000000000
CANCEL_TOKEN_SECRET= # openssl rand -hex 32
COUPON_WEBHOOK_SECRET= # openssl rand -hex 32
