# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Zoom (Server-to-Server OAuth)
# https://marketplace.zoom.us/
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@example.com
EMAIL_DELIVERY_MODE=resend # or log

# Firebase Admin
# FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY can be left empty when using
# Application Default Credentials or service account impersonation locally.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# App URLs
# API_URL: この API サーバー自身の URL（Cloud Scheduler の OIDC audience）
# CONSOLE_APP_URL: コンソール SPA の URL（通知リンク生成用）
# CORS_ALLOWED_ORIGINS: CORS 許可オリジン（カンマ区切り）
API_URL=http://localhost:3000
CONSOLE_APP_URL=http://localhost:3020
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3020

INVOICE_REGISTRATION_NUMBER=T0000000000000
CANCEL_TOKEN_SECRET=your-cancel-token-secret

# LINE WORKS late arrival alerts
LINE_WORKS_LATE_ARRIVAL_WEBHOOK_URL=https://webhook.worksmobile.com/message/...
