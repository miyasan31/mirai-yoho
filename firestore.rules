rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function membershipDocPath(organizationId) {
      return /databases/$(database)/documents/organization-memberships/$(organizationId + "_" + request.auth.uid);
    }

    function membershipExists(organizationId) {
      return isAuthenticated() && exists(membershipDocPath(organizationId));
    }

    function membershipData(organizationId) {
      return get(membershipDocPath(organizationId)).data;
    }

    function isActiveMember(organizationId) {
      return membershipExists(organizationId)
        && membershipData(organizationId).status == 'active';
    }

    function hasOrganizationRole(organizationId, roles) {
      return isActiveMember(organizationId)
        && membershipData(organizationId).role in roles;
    }

    function isOrganizationAdmin(organizationId) {
      return hasOrganizationRole(organizationId, ['admin', 'operator']);
    }

    function isOrganizationSuperAdmin(organizationId) {
      return hasOrganizationRole(organizationId, ['admin']);
    }

    function isOrganizationConsultant(organizationId) {
      return hasOrganizationRole(organizationId, ['consultant']);
    }

    match /organizations/{organizationId} {
      allow read: if isActiveMember(organizationId);
      allow write: if false;
    }

    match /organization-memberships/{membershipId} {
      allow read: if isAuthenticated()
        && (
          resource.data.uid == request.auth.uid
          || isOrganizationAdmin(resource.data.organizationId)
        );
      allow write: if false;
    }

    match /organization-settings/{organizationId} {
      allow read: if isOrganizationAdmin(organizationId);
      allow write: if isOrganizationSuperAdmin(organizationId);
    }

    match /consultants/{consultantId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        || (
          hasOrganizationRole(request.resource.data.organizationId, ['consultant'])
          && request.resource.data.consultantId == request.auth.uid
        );
      allow update, delete: if isOrganizationAdmin(resource.data.organizationId)
        || (
          isOrganizationConsultant(resource.data.organizationId)
          && resource.data.consultantId == request.auth.uid
        );
    }

    match /slots/{slotId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        || (
          hasOrganizationRole(request.resource.data.organizationId, ['consultant'])
          && request.resource.data.consultantId == request.auth.uid
        );
      allow update, delete: if isOrganizationAdmin(resource.data.organizationId)
        || (
          hasOrganizationRole(resource.data.organizationId, ['consultant'])
          && resource.data.consultantId == request.auth.uid
        );
    }

    match /bookings/{bookingId} {
      allow read: if isOrganizationAdmin(resource.data.organizationId)
        || (
          isOrganizationConsultant(resource.data.organizationId)
          && resource.data.consultantId == request.auth.uid
        );
      allow write: if isOrganizationAdmin(request.resource.data.organizationId);
    }

    match /payments/{paymentId} {
      allow read: if isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

    match /user-preferences/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
