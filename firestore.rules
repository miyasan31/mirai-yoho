// このファイルは Terraform 管理です（infra/terraform/gcp/common/firebase-rules）。
// google_firebaserules_ruleset/release がこのファイルを読み込んでデプロイします。
// `firebase deploy --only firestore` 等の CLI で配信しないこと（state ドリフトの原因になります）。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function accountDocPath(organizationId) {
      return /databases/$(database)/documents/accounts/$(organizationId + "_" + request.auth.uid);
    }

    function accountExists(organizationId) {
      return isAuthenticated() && exists(accountDocPath(organizationId));
    }

    function accountData(organizationId) {
      return get(accountDocPath(organizationId)).data;
    }

    function isActiveMember(organizationId) {
      return accountExists(organizationId)
        && accountData(organizationId).status == 'active';
    }

    function hasRoleId(organizationId, roleIds) {
      return isActiveMember(organizationId)
        && accountData(organizationId).roleId in roleIds;
    }

    function consultantDocPath(organizationId) {
      return /databases/$(database)/documents/consultants/$(organizationId + "_" + request.auth.uid);
    }

    function isOrganizationConsultant(organizationId) {
      return isActiveMember(organizationId)
        && exists(consultantDocPath(organizationId));
    }

    function isOrganizationAdmin(organizationId) {
      return hasRoleId(organizationId, ['admin', 'operator']);
    }

    function isOrganizationSuperAdmin(organizationId) {
      return hasRoleId(organizationId, ['admin']);
    }

    match /organizations/{organizationId} {
      allow read: if isActiveMember(organizationId);
      allow write: if false;
    }

    match /accounts/{accountId} {
      allow read: if isAuthenticated()
        && (
          resource.data.accountId == request.auth.uid
          || isOrganizationAdmin(resource.data.organizationId)
        );
      allow write: if false;
    }

    match /settings/{organizationId} {
      allow read: if isOrganizationAdmin(organizationId);
      allow write: if isOrganizationSuperAdmin(organizationId);
    }

    match /consultants/{consultantId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        || (
          isOrganizationConsultant(request.resource.data.organizationId)
          && request.resource.data.consultantId == request.auth.uid
        );
      allow update, delete: if isOrganizationAdmin(resource.data.organizationId)
        || (
          isOrganizationConsultant(resource.data.organizationId)
          && resource.data.consultantId == request.auth.uid
        );
    }

    match /slots/{slotId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        || (
          isOrganizationConsultant(request.resource.data.organizationId)
          && request.resource.data.consultantId == request.auth.uid
        );
      allow update, delete: if isOrganizationAdmin(resource.data.organizationId)
        || (
          isOrganizationConsultant(resource.data.organizationId)
          && resource.data.consultantId == request.auth.uid
        );
    }

    match /bookings/{bookingId} {
      allow read: if isOrganizationAdmin(resource.data.organizationId)
        || (
          isOrganizationConsultant(resource.data.organizationId)
          && resource.data.consultantId == request.auth.uid
        );
      allow write: if isOrganizationAdmin(request.resource.data.organizationId);
    }

    match /payments/{paymentId} {
      allow read: if isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if isActiveMember(resource.data.organizationId);
      allow write: if false;
    }

    match /user-coupons/{userCouponId} {
      // 顧客用の userId は User 集約の UUID（Firebase Auth UID とは別）なので
      // クライアントから直接読ませない。参照は API 経由（Firebase Admin SDK が rules をバイパス）。
      allow read: if resource.data.organizationId is string
        && isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

    match /policy-revisions/{revisionId} {
      // published 版は API 経由の公開エンドポイントに委ね、Firestore への直読は
      // 組織 admin のみ許容する（draft/archived を含む全履歴を触れる）。
      allow read: if isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

    match /policy-agreements/{agreementId} {
      // 同意証跡は API 経由（Firebase Admin SDK が rules をバイパス）でのみ書き込み、
      // クライアントからの直読は組織 admin にのみ許容する。
      allow read: if resource.data.organizationId is string
        && isOrganizationAdmin(resource.data.organizationId);
      allow write: if false;
    }

  }
}
